# MechWarrior 3 (Zipper Interactive, 1999), on pcrecomp native32 (x86 host).
# The lifted C (src/recomp/gen) is generated in the checkout by run_lift.py and
# goes over with it; the game itself (game/, work/) never does.
REPO=https://github.com/sp00nznet/mechwarrior3-recomp
TOOLSET=cmake
DEPS=pcrecomp
BUILD_ARGS="-DXWIN_ARCH=x86 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DPCRECOMP=../pcrecomp"
EXCLUDE="build build-farm work game disc_image game_files analysis"
EXE=mw3.exe
# A machine with the game in game\ runs the conformance script; the test VMs
# have no game data and report SKIP.
RUN_FILES="tools/conformance.py conformance.json"
QA='py -3 tools\conformance.py --host $EXE'
QA_SKIP='^conformance: skipped'
SHIP=lan                           # built from a retail product: stays on the LAN
