# Hover! (Microsoft, 1995), on pcrecomp native32 (x86 host). The lifted C
# (src/recomp/gen) is generated in the checkout by run_lift.py and goes over
# with it; the game itself (game/) never does.
REPO=https://github.com/sp00nznet/hover
TOOLSET=cmake
DEPS=pcrecomp
BUILD_ARGS="-DXWIN_ARCH=x86 -DPCRECOMP=../pcrecomp"
TARGET=hover
EXCLUDE="build build-dev build-farm work game *.mp4 *.zip"
EXE=hover.exe
# The test VMs have no game data; with game\hover in place it plays headless.
RUN='$EXE --run --headless'
PROC=hover
SHIP=lan                           # built from a retail product: stays on the LAN
