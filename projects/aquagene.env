# AQUA-GENE: a genetics aquarium idle sim (C++20, SDL3, CMake). Private game.
REPO=https://github.com/sp00nznet/aquagene
TOOLSET=cmake
EXCLUDE='build dist out assets/fish/_raw assets/fish/_cut'
ARTIFACTS='build/bin/AquaGene.exe build/bin/SDL3.dll build/bin/ag_tests.exe assets'
EXE=AquaGene.exe
RUN='$EXE'
WINDOW=AQUA-GENE
SHIP=lan
# The core tests (genetics golden pins, the idle soak), then the sprite gate.
QA='ag_tests.exe && $EXE --fit'
