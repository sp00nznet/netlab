# snesrecomp: the SNES toolkit (LakeSnes + SDL2 runtime), a dependency of the
# SNES game repos. Builds the minimal example to prove the library links.
# SDL2 is only on the mingw builder, so it cross-builds with mingw-w64 GCC.
REPO=https://github.com/sp00nznet/snesrecomp
TOOLSET=script
BUILDS_ON=mingw
BUILD='cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ -DCMAKE_PREFIX_PATH=/opt/sdl2-mingw -DCMAKE_EXE_LINKER_FLAGS="-static -static-libgcc" && cmake --build build -j"$(nproc)"'
ARTIFACTS='build/*.exe'
EXCLUDE="build *.sfc *.smc"
