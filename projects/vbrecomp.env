# vbrecomp: the Virtual Boy toolkit (v810recomp recompiler + runtime). No ROMs
# leave the checkout, so the farm builds the library, the recompiler and
# test_mem; the game targets skip at configure time ("not generated yet").
# SDL2 isn't on the clang-cl builder, so the runtime builds its headless stub.
# QA is test_mem. tools/conformance.py needs MSVC on the runner, so it runs in
# GitHub CI and on the workstation, not here.
REPO=https://github.com/sp00nznet/vbrecomp
TOOLSET=script
BUILDS_ON=clangcl
BUILD='cmake -S . -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=/opt/clangcl.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded && cmake --build build -j"$(nproc)"'
ARTIFACTS='build/*.exe'
EXCLUDE="build build_all build-farm corpus roms games/*/generated *.vb"
EXE=test_mem.exe
QA='$EXE'
SHIP=none
