# Stunt Race FX, statically recompiled on snesrecomp (Super FX via the LakeSnes
# fork's GSU-2). SDL2 is only on the mingw builder, so it cross-builds with
# mingw-w64 GCC. The ROM never leaves the checkout.
REPO=https://github.com/sp00nznet/stuntrace
TOOLSET=script
BUILDS_ON=mingw
BUILD='cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ -DCMAKE_PREFIX_PATH=/opt/sdl2-mingw -DCMAKE_EXE_LINKER_FLAGS="-static -static-libgcc -static-libstdc++" && cmake --build build -j"$(nproc)" && cp /opt/sdl2-mingw/bin/SDL2.dll build/'
ARTIFACTS='build/*.exe build/SDL2.dll'
EXCLUDE="build build-farm gen scratch *.sfc *.smc *.zip *.sav *.mp4 *.bmp *.log"
EXE=srf_launcher.exe
SHIP=lan                           # built from a retail ROM: stays on the LAN
