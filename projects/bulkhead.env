# bulkhead: block-level backup, recovery and secure erase for Windows (Rust, Win32).
# The library is Windows-only, so the Linux builder lints and cross-builds but can't
# run the tests; `cargo test` and the conformance harness run in GitHub Actions on a
# Windows runner (admin, so it can make and destroy VHDs). QA here is the window.
REPO=https://github.com/sp00nznet/bulkhead
TOOLSET=script
BUILDS_ON=rust
BUILD='. ~/.cargo/env && cargo fmt --check && cargo xwin clippy --release --target x86_64-pc-windows-msvc --all-targets -- -D warnings && cargo xwin build --release --target x86_64-pc-windows-msvc && rm -rf build && mkdir build && cp target/x86_64-pc-windows-msvc/release/bulkhead.exe target/x86_64-pc-windows-msvc/release/bulkhead-gui.exe build/'
ARTIFACTS='build/bulkhead.exe build/bulkhead-gui.exe'
EXE=bulkhead-gui.exe
RUN='$EXE'
PROC=bulkhead-gui
WINDOW=bulkhead
QA_STEPS=projects/bulkhead.qa
SHIP=github
