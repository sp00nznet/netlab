# Crazy Taxi (Dreamcast), on dcrecomp. src/game/ is generated in the checkout
# from your own disc (README) and is never committed; the disc image and
# disc_extract/ never leave the checkout. SDL2 isn't on the clang-cl builders,
# so this builds the headless configuration - enough for the boot smoke test.
REPO=https://github.com/sp00nznet/crazytaxi
TOOLSET=cmake
TARGET=crazytaxi
EXE=crazytaxi.exe
EXCLUDE="disc_extract build_old3 *.bin *.cue *.7z *.log"
RUN='$EXE'
RUN_FILES=tools/smoke_test.py
QA='py -3 tools\smoke_test.py $EXE'
QA_SKIP='^SKIP: disc_extract'
SHIP=lan                           # built from a retail disc: stays on the LAN
