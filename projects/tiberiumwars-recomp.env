# Command & Conquer 3: Tiberium Wars (RetailExe\1.10\cnc3game.dat), on pcrecomp
# (x86 host). The lifted C (src/recomp/gen) is generated in the checkout by
# run_lift.py and goes over with it; the game itself (game/) never does.
REPO=https://github.com/sp00nznet/tiberiumwars-recomp
TOOLSET=cmake
DEPS=pcrecomp=tools
BUILD_ARGS="-DXWIN_ARCH=x86"
TARGET=tw
EXE=tw.exe
# Bring-up: a bounded run that ends in the host's own report. TW_GAME is a
# machine's folder holding the game; without it, the checkout's game\ is used.
RUN='$EXE --run --headless --watchdog 60 ${TW_GAME:+--game $TW_GAME}'
PROC=tw
SHIP=lan                           # built from a retail product: stays on the LAN
