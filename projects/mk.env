# Super Mario Kart (SNES), statically recompiled on snesrecomp. SDL2 is only
# on the mingw builder, so it cross-builds with mingw-w64 GCC. The ROM and the
# ROM-generated src/recomp/smk_autogen.c never leave the checkout, so the farm
# builds the default path without it.
REPO=https://github.com/sp00nznet/mk
TOOLSET=script
BUILDS_ON=mingw
BUILD='cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ -DCMAKE_PREFIX_PATH=/opt/sdl2-mingw -DCMAKE_EXE_LINKER_FLAGS="-static -static-libgcc -static-libstdc++" && cmake --build build -j"$(nproc)" && cp /opt/sdl2-mingw/bin/SDL2.dll build/'
ARTIFACTS='build/*.exe build/SDL2.dll'
EXCLUDE="build build-farm snap *.sfc *.smc *.srm *.sav *.zip *.bmp *.log *.err *.tmp *.mp4 smk_config.ini src/recomp/smk_autogen.c tools/*.txt tools/mesen/Mesen2 tools/bizhawk/BizHawk*"
EXE=smk_launcher.exe
SHIP=lan                           # built from a retail ROM: stays on the LAN
