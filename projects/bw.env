# Black & White (2001), a hand-translated static recompilation: bw_core, the
# bw_viewer game shell and its test exes, all 32-bit. CMake lives in src/, so
# this is a script build on the clang-cl builder. The retail data dirs never
# leave the checkout; tests that want game data print "note: ... skipped".
REPO=https://github.com/sp00nznet/bw
TOOLSET=script
BUILDS_ON=clangcl
BUILD='cmake -S src -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=/opt/clangcl.cmake -DXWIN_ARCH=x86 -DCMAKE_BUILD_TYPE=Release && cmake --build build -j"$(nproc)"'
ARTIFACTS='build/*.exe'
EXCLUDE="game_data game_extracted game_files disc_image vendor *.png"
EXE=bw_viewer.exe
RUN='$EXE game_data\Land1.txt --play'
RUN_FILES=tools/run_tests.cmd
WINDOW=bw_viewer
QA='tools\run_tests.cmd "$EXE"'
QA_SKIP='note: .*skipped'
SHIP=none
