# Crimson Skies (Zipper Interactive, 2000), on pcrecomp native32 (x86 host).
# The lifted C (src/recomp/gen) is generated in the checkout by run_lift.py from
# the decrypted CRIMSON.ICD and goes over with it; the game itself never does.
REPO=https://github.com/sp00nznet/crimsonskies
TOOLSET=cmake
DEPS=pcrecomp
BUILD_ARGS="-DXWIN_ARCH=x86 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DPCRECOMP=../pcrecomp"
EXCLUDE="build build-n32 work analysis game_disc iso extracted mod_edition config"
EXE=crimson.exe
SHIP=lan                           # built from a retail product: stays on the LAN
