# Star Wars: X-Wing Alliance (xwingalliance.exe, SafeDisc-decrypted), on XWA's own
# lifter (an older fork of pcrecomp's lift32; no DEPS yet). The lifted C
# (src/game/recomp/gen) is generated in the checkout and goes over with it; the
# decrypted exe (config/*.exe) and the game install never do. /O1 for the
# generated C, as kotor: /O2's loop unswitching is quadratic under clang.
REPO=https://github.com/sp00nznet/xwa
TOOLSET=cmake
BUILD_ARGS="-DXWIN_ARCH=x86 -DGEN_OPT=/O1"
TARGET=xwa_recomp
EXE=xwa_recomp.exe
EXCLUDE="config docs Star*"
# The machine's XWA_GAME is the game install with xwingalliance_decrypted.exe
# copied into it; the run needs it as its working directory.
RUN='tools\netlab_run.cmd $EXE $XWA_GAME'
RUN_FILES=tools/netlab_run.cmd
PROC=xwa_recomp
WINDOW="X-Wing Alliance"
SHIP=lan                           # built from a retail product: stays on the LAN
