# Microsoft Space Simulator (DOS, Bruce Artwick Organization 1994), on
# pcrecomp's recomp16 runtime. The lifted C (work/<program>/gen: the game, its
# launcher SS1 and the 21 install tools) is generated in the checkout by
# tools/lift.py from your copy of the game and goes over with it; the game
# itself (game/, original/, the unpacked images in work/) never does. The
# toolkit is the checkout's own pcrecomp tree (its integration branch), as
# ../pcrecomp.
REPO=https://github.com/sp00nznet/msspacesim
TOOLSET=cmake
DEPS=pcrecomp
KEEP=work
EXCLUDE="work/converge work/converge.log work/screens work/explore work/st work/shots work/unpacked work/*/image.bin work/*/misses*.txt work/*/lift.json"   # tar: * crosses /
ARTIFACTS='build/*.exe'
EXE=spacesim.exe
RUN='$EXE'
# The hardware models (VGA, OPL, x87) against known answers: no game data
# needed, so it runs on the test VMs.
QA='selftest.exe'
PROC=spacesim
WINDOW="Microsoft Space Simulator"
SHIP=lan                           # built from a retail product: stays on the LAN
