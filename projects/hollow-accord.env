# HOLLOW ACCORD (Godot 4.7, private): the TMP spin-out (accord.gd). The selftest is the gate (every area,
# all three endings, the faction choices, both field builds, save/load).
REPO=https://github.com/Doublehash/hollow-accord
TOOLSET=script
BUILDS_ON=godot
BUILD='mkdir -p export/windows && godot-4.7 --headless --path . --import && godot-4.7 --headless --path . -s tools/selftest.gd && godot-4.7 --headless --path . --export-release "Windows Desktop" export/windows/HollowAccord.exe && mkdir -p export/linux && godot-4.7 --headless --path . --export-release Linux export/linux/HollowAccord.x86_64'
ARTIFACTS='export/windows/HollowAccord.exe export/linux/HollowAccord.x86_64'
EXE=HollowAccord.exe
RUN='$EXE'
WINDOW='HOLLOW ACCORD'
EXE_LINUX=HollowAccord.x86_64
RUN_LINUX='$EXE'
PROC_LINUX=HollowAccord.x86_64
QA_STEPS_LINUX=tools/qa/boot.steps
