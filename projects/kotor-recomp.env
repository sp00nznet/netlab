# Star Wars: Knights of the Old Republic (swkotor.exe 1.03), on pcrecomp (x86
# host, native32). The lifted C (src/recomp/gen) is generated in the checkout
# by run_lift.py and goes over with it; game/ (a junction to the install) and
# work/ (the unwrapped exe, the catalog) never do. /O1 for the generated C, as
# Rise of Legends: /O2's loop unswitching is quadratic on the lift's huge
# functions under clang.
REPO=https://github.com/sp00nznet/kotor-recomp
TOOLSET=cmake
DEPS=pcrecomp=pcrecomp
BUILD_ARGS="-DXWIN_ARCH=x86 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DGEN_OPT=/O1"
TARGET=kotor
EXE=kotor.exe
# Muted and windowless by default for test runs; the checkout's work\swkotor.exe
# and game\ are used.
RUN='$EXE --run --headless --watchdog 60'
PROC=kotor.exe
WINDOW="Star Wars: Knights of the Old Republic"
QA='py -3 tools\conformance.py'
QA_SKIP='conformance: skipped'
SHIP=lan                           # built from a retail product: stays on the LAN
