# Rise of Legends, on pcrecomp (x86 host, MSVC inline asm). The lift's huge
# functions need /O1 under clang: /O2's loop unswitching is quadratic on them.
REPO=https://github.com/sp00nznet/rol
TOOLSET=cmake
DEPS=pcrecomp=pcrecomp-rol
BUILD_ARGS="-DXWIN_ARCH=x86 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DGEN_OPT=/O1"
EXE=rol.exe
RUN='$EXE --run --watchdog 60'
SHIP=lan
