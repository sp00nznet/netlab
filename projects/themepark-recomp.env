# Theme Park (DOS, Bullfrog 1994), on pcrecomp's LE front end and dos32 host
# (x64 host). The lifted C (src/recomp/gen) is generated in the checkout by
# run_lift.py and goes over with it; the game itself (game/) never does.
REPO=https://github.com/sp00nznet/themepark-recomp
TOOLSET=cmake
DEPS=pcrecomp=tools
BUILD_ARGS="-DXWIN_ARCH=x86_64"
TARGET=themepark
EXCLUDE="build build-dev build-farm work game analysis/d32_funcs.json *.mp4"
EXE=themepark.exe
# A machine with the game in game\ runs the 6-milestone conformance script;
# the test VMs have no game data and report SKIP.
RUN='$EXE'
RUN_FILES="tools/qa.cmd tools/conformance.py conformance.json"
QA='tools\qa.cmd $EXE'
QA_SKIP='^SKIP: no game data'
PROC=themepark
WINDOW="Theme Park"
SHIP=lan                           # built from a retail product: stays on the LAN
