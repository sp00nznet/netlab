# Optics: a Win32 3D model viewer (C, OpenGL 1.1, ufbx).
REPO=https://github.com/sp00nznet/Optics
TOOLSET=cmake
ARTIFACTS='build/bin/Optics.exe build/bin/optics-check.exe'
EXE=Optics.exe
RUN='$EXE sample-models'
SHIP=github
WINDOW=Optics
# Self-test, then the conformance corpus (docs/conformance.md); non-zero exit on any failure.
QA='tools\qa.cmd "$EXE"'
RUN_FILES='tools/qa.cmd sample-models tests'
