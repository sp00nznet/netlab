# SEALBREAKER (Godot 4.7, private). The owned packs are gitignored, so a farm build uses the
# code-built stand-ins; the gates (selftest, soak) don't need the art.
REPO=https://github.com/sp00nznet/sealbreaker
TOOLSET=script
BUILDS_ON=godot
BUILD='mkdir -p build export/windows && godot-4.7 --headless --path . --import && godot-4.7 --headless --path . -s tools/selftest.gd && godot-4.7 --headless --path . --export-release "Windows Desktop" export/windows/Sealbreaker.exe'
ARTIFACTS='export/windows/Sealbreaker.exe'
EXE=Sealbreaker.exe
RUN='$EXE'
WINDOW=SEALBREAKER
SHIP=itch
ITCH_TARGET=sp00nz/sealbreaker:windows
