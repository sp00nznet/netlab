# Mario Paint (SNES), statically recompiled on snesrecomp. SDL2 is only on the
# mingw builder, so it cross-builds with mingw-w64 GCC. SDL2.dll comes back
# with the exe. The ROM never leaves the checkout, so QA on a lab machine
# reports SKIP (tools/conformance.py needs it).
REPO=https://github.com/sp00nznet/mariopaint
TOOLSET=script
BUILDS_ON=mingw
BUILD='cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DCMAKE_CXX_COMPILER=x86_64-w64-mingw32-g++ -DCMAKE_PREFIX_PATH=/opt/sdl2-mingw -DCMAKE_EXE_LINKER_FLAGS="-static -static-libgcc -static-libstdc++" && cmake --build build -j"$(nproc)" && cp /opt/sdl2-mingw/bin/SDL2.dll build/'
ARTIFACTS='build/*.exe build/SDL2.dll'
EXCLUDE="build build-farm scratch gen _recovered *.sfc *.smc *.zip *.sav *.bmp *.ini ppudump.txt"
EXE=mp_launcher.exe
SHIP=lan                           # built from a retail ROM: stays on the LAN
