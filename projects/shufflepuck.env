# Shufflepuck Cafe (Mac 68k, Broderbund 1988), on macrecomp (ext/macrecomp,
# a submodule that goes over with the checkout). build.sh cross-builds with the
# mingw builder's gcc + SDL2; with no disk image it compiles the lifted C
# already in src/gen. The image (original/) and work/ never leave.
REPO=https://github.com/sp00nznet/shufflepuck-cafe
TOOLSET=script
BUILDS_ON=mingw
BUILD='CC=x86_64-w64-mingw32-gcc PKG_CONFIG=mingw-pkg-config ./build.sh && cp /opt/sdl2-mingw/bin/SDL2.dll build/'
ARTIFACTS='build/*.exe build/*.dll'
EXCLUDE="*.mp4 *.pgm"
EXE=shufflepuck.exe
# The test VMs have no game data, so the harness reports SKIPPED there.
RUN='$EXE --headless --watchdog 20'
RUN_FILES="tools/qa.cmd tools/conformance.py conformance.json"
QA='tools\qa.cmd'
QA_SKIP='^SKIP: no game data'
PROC=shufflepuck
SHIP=lan                           # built from a retail product: stays on the LAN
