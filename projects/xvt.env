# Star Wars: X-Wing vs TIE Fighter (1.10, Steam), on pcrecomp native32 with
# the X-Wing/TIE remaster. The lifted C is generated in the checkout; the game
# (game/) and the unwrapped exe (work/xvt.exe) never go over with the build:
# each machine has its own copy at XVT_GAME and XVT_EXE.
# Each role drives the game with its own --keys script (KEYS), so the pictures
# are the game's own frames (shot=...), never the screen.
REPO=https://github.com/sp00nznet/xvt-recomp
TOOLSET=cmake
DEPS=pcrecomp
BUILD_ARGS="-DCMAKE_BUILD_TYPE=RelWithDebInfo -DPCRECOMP=../pcrecomp"
TARGET=xvt
EXCLUDE="build build-farm work game *.png *.gif"
EXE=xvtrecomp.exe
RUN='$EXE --run --exe $XVT_EXE --game $XVT_GAME --watchdog ${WATCHDOG:-300} --keys \"$KEYS\"'
PROC=xvtrecomp
WINDOW="X-Wing vs TIE Fighter"
SHIP=lan                           # built from a retail product: stays on the LAN
