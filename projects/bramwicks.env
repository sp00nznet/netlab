# THE BRAMWICKS: an ASCII 90s family sitcom (C++17, SDL2 fetched and built static by CMake).
# The audio travels next to the exe in audio/game.
REPO=https://github.com/sp00nznet/bramwicks
TOOLSET=cmake
TARGET=bramwicks
EXCLUDE="build build-web"
ARTIFACTS='build/bramwicks.exe build/audio'
EXE=bramwicks.exe
RUN='$EXE'
WINDOW='THE BRAMWICKS'
PROC=bramwicks
QA='$EXE --selftest'
SHIP=github
