# Red Alert 2 / Yuri's Revenge (gamemd.exe), on pcrecomp (x86 host).
# The lifted C (src/recomp/gen) is generated in the checkout by run_lift.py
# and goes over with it; the game itself (game/) never does.
REPO=https://github.com/sp00nznet/redalert2-recomp
TOOLSET=cmake
DEPS=pcrecomp=tools
BUILD_ARGS="-DXWIN_ARCH=x86"
TARGET=ra2
EXE=ra2.exe
# The machine's RA2_GAME is a folder holding the game (gamemd.exe and its
# MIX files); without it, the checkout's own game\ is used.
# --mute: test runs make no sound on a machine someone uses.
# A role's RA2_ARGS is a file of host arguments, a script of presses (the
# repo's tools/lan/*.args for the LAN game).
RUN='$EXE --run --mute ${RA2_GAME:+--game $RA2_GAME --exe $RA2_GAME\gamemd.exe} ${RA2_ARGS:+--args $RA2_ARGS}'
RUN_FILES="tools/lan/host.args tools/lan/joiner.args"
PROC=ra2
WINDOW="Yuri's Revenge (recomp)"
SHIP=lan                           # built from a retail product: stays on the LAN
