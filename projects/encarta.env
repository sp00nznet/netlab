# Encarta 97, statically recompiled (x86 -> C), with its own harness.
# The lift (tools/recomp/enc97_full.c) is generated from your copy of the
# product, so building needs a checkout that has it; see the repo's
# docs/GETTING-STARTED.md. Running needs a content mirror (ENCARTA_CONTENT on
# the machine) and the app's own files: the checkout's analysis/, or
# ENCARTA_APP on the machine.
REPO=https://github.com/sp00nznet/encarta
TOOLSET=cmake
BUILD_ARGS="-DXWIN_ARCH=x86"
TARGET=recomp_enc97_run
ARTIFACTS=build/tools/recomp/recomp_enc97_run.exe
EXE=recomp_enc97_run.exe
RUN='powershell -NoProfile -ExecutionPolicy Bypass -File tools\localcontent\run-encarta.ps1 -Content $ENCARTA_CONTENT ${ENCARTA_APP:+-AppDir $ENCARTA_APP} -Harness $EXE -Hold'
SHIP=lan     # built from a retail product: stays on the LAN
WINDOW="Microsoft Encarta"
# Its regress.py checks the checkout's own (Visual Studio) build, not this one,
# so QA here is the app itself: it boots to an article, and Find opens.
QA_STEPS=projects/encarta.qa
