# Vibewright: an agentic game-building tool (Node 22, TypeScript; makes Godot 4 projects). Private.
# The farm builds it and runs its tests (the QA-gate test needs Godot and is skipped on the node
# builder); the package is what a test VM installs. The guide itself is a terminal program, so
# there is no window to run here: test VMs run it from a fresh clone (see its README).
# It needs Node 22.13+ (node:sqlite) and the node builder has 20, so the build brings its own,
# pinned by hash, into the workspace.
REPO=https://github.com/sp00nznet/vibewright
TOOLSET=script
BUILDS_ON=node
BUILD='N=node-v22.23.4-linux-x64; [ -x $HOME/$N/bin/node ] || { curl -fsSL -o /tmp/$N.tar.xz https://nodejs.org/dist/v22.23.4/$N.tar.xz && echo "1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce  /tmp/$N.tar.xz" | sha256sum -c - && tar xJf /tmp/$N.tar.xz -C $HOME; }; export PATH=$HOME/$N/bin:$PATH; node --version; npm ci --ignore-scripts && npm run build && npm test && npm pack'
EXCLUDE='node_modules dist'
ARTIFACTS='vibewright-*.tgz'
