# A Windows machine over SSH (netlab ... --on testbox), set up with
# vm/first-boot.ps1 and vm/prepare-game-box.ps1. Programs start from a
# scheduled task in its logged-on desktop session.
KIND=remote
SSH=Admin@192.0.2.30
JUMP=                  # e.g. root@192.0.2.10 when it's behind the NAT bridge
DIR=C:/netlab          # builds go to $DIR/<project>
ENCARTA_CONTENT='C:\encarta97'
