# OpenNote: a Win32 notes app (C, Scintilla, SQLite).
REPO=https://github.com/sp00nznet/opennote
TOOLSET=cmake
ARTIFACTS=build/bin/OpenNote.exe
EXE=OpenNote.exe
RUN='$EXE'
SHIP=github  # a draft release with the exe; the installer (Inno Setup) is still built on Windows
WINDOW=OpenNote
QA='$EXE --selftest'          # its own checks; prints ok/FAIL lines, exit 0 when all hold
QA_STEPS=projects/opennote.qa # then the window and its menus, without touching any notes
