# VOIDLANCE (Godot 4.7, private): mission-based space fighter career. The selftest is the gate
# (menus, pilot save, energy split, shields, targeting, wing orders, turrets, an autopilot tour of
# all four missions, failure path, save reload). Music is build-only and absent on the farm.
REPO=https://github.com/sp00nznet/voidlance
TOOLSET=script
BUILDS_ON=godot
BUILD='mkdir -p export/windows && godot-4.7 --headless --path . --import && godot-4.7 --headless --path . -s tools/selftest.gd && godot-4.7 --headless --path . --export-release "Windows Desktop" export/windows/Voidlance.exe && mkdir -p export/linux && godot-4.7 --headless --path . --export-release Linux export/linux/Voidlance.x86_64'
ARTIFACTS='export/windows/Voidlance.exe export/linux/Voidlance.x86_64'
EXE=Voidlance.exe
RUN='$EXE'
WINDOW=VOIDLANCE
QA_STEPS=tools/qa/boot.steps
EXE_LINUX=Voidlance.x86_64
RUN_LINUX='$EXE'
PROC_LINUX=Voidlance.x86_64
QA_STEPS_LINUX=tools/qa/boot.steps
