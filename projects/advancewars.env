# Advance Wars (GBA, USA Rev 1), statically recompiled with gbarecomp. The C is
# generated from the ROM into gen/ by the checkout's build.cmd (it needs the
# ROM, so that step stays on the workstation) and goes over with the checkout;
# the root CMakeLists.txt builds it. The builder has no SDL2, so the build is
# headless-only (GBA_NO_SDL), which is all QA needs. game/ (the ROM) never
# leaves the checkout, so QA on a lab machine reports SKIP.
REPO=https://github.com/sp00nznet/advancewars
TOOLSET=script
BUILDS_ON=clangcl
BUILD='cmake -S . -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=/opt/clangcl.cmake -DCMAKE_BUILD_TYPE=Release && cmake --build build -j"$(nproc)"'
ARTIFACTS='build/*.exe'
EXCLUDE="game scratch ext recomp_aw recomp_aw2 recomp_final recomp_mgba recomp_out recomp_out3 recomp_out4 recomp_rex aw_shots aw_shots_rex *.gba *.zip *.sav *.png *.log *.bmp *.mp4"
EXE=AWRE.exe
RUN='$EXE game\aw.gba --headless --frames 600'
RUN_FILES="tools/qa.cmd conformance_baseline.txt tools/title.txt ext/gbarecomp/tools/conformance.py"
# qa.cmd reports SKIP without the ROM before it needs Python (test VMs have none)
QA='tools\qa.cmd "$EXE"'
QA_SKIP='conformance: skipped'
SHIP=lan                           # built from a retail ROM: stays on the LAN
