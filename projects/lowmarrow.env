# LOWMARROW (Godot 4.7, private): the TMP spin-out. The selftest is the gate (menus, an autopilot fight,
# 10k loot rolls per act, every boss phase, save and continue).
REPO=https://github.com/sp00nznet/lowmarrow
TOOLSET=script
BUILDS_ON=godot
BUILD='mkdir -p build export/windows && godot-4.7 --headless --path . --import && godot-4.7 --headless --path . -s tools/selftest.gd && godot-4.7 --headless --path . --export-release "Windows Desktop" export/windows/Lowmarrow.exe'
ARTIFACTS='export/windows/Lowmarrow.exe'
EXE=Lowmarrow.exe
RUN='$EXE'
WINDOW=LOWMARROW
