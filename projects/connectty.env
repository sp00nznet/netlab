# connectty: a terminal and connection manager (Electron). The farm builds the
# Linux packages; its Windows installer needs Windows (native node modules).
REPO=https://github.com/sp00nznet/connectty
TOOLSET=script
BUILDS_ON=node
BUILD='npm ci && npm run generate-icons && npm run build -w @connectty/shared && npm run build -w @connectty/desktop && cd packages/desktop && npx electron-builder --linux AppImage deb --publish never'
EXCLUDE='packages/*/release packages/*/dist android'
ARTIFACTS='packages/desktop/release/*.AppImage packages/desktop/release/*.deb'
SHIP=github
# On a Linux machine: the AppImage, and that its window comes up.
EXE_LINUX='Connectty-*-linux-x86_64.AppImage'
RUN_LINUX='$EXE'
PROC_LINUX=Connectty
WINDOW=Connectty
QA_STEPS_LINUX=projects/connectty.qa
