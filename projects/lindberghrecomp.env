# The lindberghrecomp toolkit (Sega Lindbergh), also a dependency of the
# Lindbergh games. Built alone it is the runtime self-check: 32-bit, static
# CRT so a test VM without the VC++ redistributable still runs it. No game data.
REPO=https://github.com/sp00nznet/lindberghrecomp
TOOLSET=cmake
BUILD_ARGS="-DXWIN_ARCH=x86 -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded"
EXE=lindbergh_rt_selftest.exe
QA='$EXE'
SHIP=none
