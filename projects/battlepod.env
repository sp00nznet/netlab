# battlepod: the VWE BattleTech cockpit (68020 under Musashi, SDL2 windows),
# a GNU Makefile cross-built for Windows on the mingw builder. The release it
# runs (Game Files) never goes to the farm: _dump/ and the .sit archives are
# excluded, and the test machine holds its own copy in VWE_GAME_FILES.
REPO=https://github.com/sp00nznet/battlepod
TOOLSET=script
BUILDS_ON=mingw
EXCLUDE='_dump *.sit out'
# make test first, natively (BUILD=build-linux): the self-checks run here,
# where the cross-built exes can't.
BUILD='make deps PYTHON=python3 && make -j8 BUILD=build-linux CC=clang test && make -j8 CC=x86_64-w64-mingw32-gcc HOSTCC=clang PKG_CONFIG=mingw-pkg-config all cockpit view panel build/paneltest.exe build/viewtest.exe'
ARTIFACTS='build/battlepod.exe build/cockpit.exe build/view.exe build/panel.exe build/paneltest.exe build/viewtest.exe'
EXE=cockpit.exe
# A game the way the operator console starts one (tools/play.sh): out/play.pkt
# is its packets, made on the workstation with
#   PLAY_PKT=out/play.pkt BIN=none tools/play.sh [scenario] [vehicle]
# VWE_GAME_FILES (a machine variable) is the release's Game Files, no spaces.
# SDL_RENDER_DRIVER (a machine variable) picks SDL's renderer: on a Windows
# test VM whose GPU renderers crawl (the view looks frozen), `software`.
# battlepod's docs/netlab.md has the story.
RUN='${SDL_RENDER_DRIVER:+set SDL_RENDER_DRIVER=$SDL_RENDER_DRIVER&& }$EXE $VWE_GAME_FILES\Full_Load_3_0 --duart 11000 --rstub 3FF00000 --rirq --astub --monitor --clock 2000808 --set 40000100=1234567 --packet-file out\play.pkt --live-pod --steps 100000000000 --top 0'
RUN_FILES=out/play.pkt
PROC=cockpit
WINDOW='battlepod - main view'
QA='battlepod.exe --selftest && paneltest.exe --selftest && viewtest.exe --selftest'
QA_STEPS=projects/battlepod.qa
SHIP=none
