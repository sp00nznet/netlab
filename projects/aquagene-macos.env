# AQUA-GENE, the native macOS build: one universal binary (x86_64 + arm64) from
# Build with --slot macos: the checkout is shared with aquagene.
# the Intel macos builder, SDL3 linked statically. Same checkout as aquagene.
# The core tests and the fish gate run inside BUILD (x86_64 slice).
REPO=https://github.com/sp00nznet/aquagene
TOOLSET=script
BUILDS_ON=macos
EXCLUDE='build build-linux build-macos dist out assets/audio'
BUILD='sh tools/build_unix.sh'
ARTIFACTS='build-macos/bin/AquaGene build-macos/bin/ag_tests'
SHIP=lan
