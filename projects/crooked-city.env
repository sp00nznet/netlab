# CROOKED CITY (Godot 4.7, private): the TMP spin-out (city.gd, city_net.gd). The selftest is the gate (a
# payphone job on autopilot, five stars, the pause menu, then city_wanted_check and city_net_check).
REPO=https://github.com/Doublehash/crooked-city
TOOLSET=script
BUILDS_ON=godot
BUILD='mkdir -p export/windows export/linux && godot-4.7 --headless --path . --import && godot-4.7 --headless --path . -s tools/selftest.gd && godot-4.7 --headless --path . --export-release "Windows Desktop" export/windows/CrookedCity.exe && godot-4.7 --headless --path . --export-release Linux export/linux/CrookedCity.x86_64'
ARTIFACTS='export/windows/CrookedCity.exe export/linux/CrookedCity.x86_64'
EXE=CrookedCity.exe
RUN='$EXE'
WINDOW='CROOKED CITY'
EXE_LINUX=CrookedCity.x86_64
RUN_LINUX='$EXE'
PROC_LINUX=CrookedCity.x86_64
