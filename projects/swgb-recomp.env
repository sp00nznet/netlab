# Star Wars: Galactic Battlegrounds (LucasArts/Ensemble, PC 2001, v1.1), on
# pcrecomp native32 (x86 host), pcrecomp main. The lifted C (src/recomp/gen,
# 4.0M lines) is generated in the checkout by run_lift.py and goes over with
# it; the game (game/, cd/, work/) never does. A build to play at high
# resolution or over the LAN: --slot o1 -- -DGEN_OPT=/O1 (build-farm-o1/,
# about 20 minutes cold); scenarios/swgb/lan.sh plays two machines.
REPO=https://github.com/sp00nznet/swgb-recomp
TOOLSET=cmake
DEPS=pcrecomp
# /Od for the generated C: the farm stalled on Shogo's lift at /O2.
BUILD_ARGS="-DXWIN_ARCH=x86 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DPCRECOMP=../pcrecomp -DGEN_OPT=/Od"
TARGET=swgb
EXCLUDE="build build-farm work game cd *.mp4 *.iso *.zip *.bin *.cue"
EXE=swgbrecomp.exe
# The test VMs have no game data (game\, cd\ and work\ stay behind), so QA
# reports SKIP there; with the data it is 5 milestones, boot to the menu's Exit.
RUN='$EXE --run --headless --watchdog 60'
RUN_FILES=tools/conformance.py
QA='py -3 tools\conformance.py $EXE'
QA_SKIP='^SKIP:'
PROC=swgbrecomp
SHIP=lan                           # built from a retail product: stays on the LAN
