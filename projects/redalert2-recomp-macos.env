# Red Alert 2 / Yuri's Revenge, the native macOS host (build-macos.sh), on a
# macos builder: the same checkout as redalert2-recomp, lifted C and all, and
# pcrecomp next to it. Yuri's Revenge by default; Red Alert 2 (game.exe) with
#   netlab build redalert2-recomp-macos -- -DRA2_TARGET=game
# The game itself never goes over; tests run on the Mac with its own copy.
REPO=https://github.com/sp00nznet/redalert2-recomp
TOOLSET=script
BUILDS_ON=macos
DEPS=pcrecomp
# What build-macos.sh does, configured every time so -D arguments take
# (a --slot keeps Red Alert 2's build dir apart from Yuri's Revenge's).
BUILD='cmake -S . -B build-macos -G Ninja -DPCRECOMP="$(cd ../pcrecomp && pwd)" $CMAKE_ARGS && cmake --build build-macos -j"$(getconf _NPROCESSORS_ONLN)"'
ARTIFACTS='build-macos/ra2'
SHIP=lan                           # built from a retail product: stays on the LAN
