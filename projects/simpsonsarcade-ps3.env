# The Simpsons Arcade Game (PS3), on ps3recomp.
REPO=https://github.com/sp00nznet/simpsonsarcade-ps3
TOOLSET=ps3recomp
DEPS=ps3recomp
EXE=simpsons.exe
# Run from the game's data (SIMPSONS_DIR on the machine: the tree with vfs\),
# set up to be driven: buttons from the instance's pad mailbox, online through
# psnr as PLAYER (scenarios/simpsons-arcade/). PS3_VERBOSE=0, or a game in
# play crawls at about 1 fps.
RUN='cd /d $SIMPSONS_DIR && set PS3_VERBOSE=0&& set RSX_LIVE_DRAW=1&& set PAD_FILE=$PAD&& set PS3_NET_P2P_PORT=${P2P_PORT:-3658}&& $EXE vfs\PS3_GAME\USRDIR\EBOOT.elf ${PSNR:+--psnr $PSNR} ${PLAYER:+--username $PLAYER}'
SHIP=lan
