# psnr: the PSN replacement server the online scenarios play through. Its
# tests run on the builder before the build; the binary is static, for any
# Linux host. Run it where every player can reach it: for a player behind
# the NAT bridge, a host on the LAN, not the NAT host. Status page:
# ssh -L 36101:127.0.0.1:36101 <host>, then http://127.0.0.1:36101/.
REPO=https://github.com/sp00nznet/psnr
TOOLSET=script
BUILDS_ON=go
BUILD='go test ./server/... && CGO_ENABLED=0 go build -o psnr-linux ./server'
ARTIFACTS=psnr-linux
EXE_LINUX=psnr-linux
RUN_LINUX='$EXE -v -http 127.0.0.1:36101 $PSNR_FLAGS'
PROC_LINUX=psnr-linux
SHIP=github
