# AQUA-GENE, the native Linux build (x86_64, SDL3 linked statically): the same
# Build and run with --slot linux: the checkout is shared with aquagene, so a slot keeps
# this build in build-farm-linux instead of on top of the Windows one.
# checkout as aquagene, built on a clangcl builder with its host clang. The core
# tests and the fish gate run inside BUILD, so a build that came back passed them.
REPO=https://github.com/sp00nznet/aquagene
TOOLSET=script
BUILDS_ON=clangcl
EXCLUDE='build build-linux build-macos dist out'
# Inside the builder's Ubuntu 22.04 root (builders/clangcl/jammy.sh): glibc 2.35, so it runs on
# Ubuntu 22.04 / Mint 21 and newer.
BUILD='jammy sh tools/build_unix.sh'
ARTIFACTS='build-linux/bin/AquaGene build-linux/bin/ag_tests assets'
EXE_LINUX=AquaGene
RUN_LINUX='$EXE'
PROC_LINUX=AquaGene
WINDOW=AQUA-GENE
QA_LINUX='./ag_tests && ./AquaGene --fit'
SHIP=lan
