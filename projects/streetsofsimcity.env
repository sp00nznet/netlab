# Streets of SimCity, on pcrecomp native32 (x86 host). The lifted C
# (src/recomp/gen) is generated in the checkout by run_lift.py and goes over
# with it; the game itself (game/, original/, work/) never does.
# Needs pcrecomp #92 and #93 until they merge: point the pcrecomp checkout at a
# tree with both (local/checkouts, `streetsofsimcity:pcrecomp`).
REPO=https://github.com/sp00nznet/streetsofsimcity
TOOLSET=cmake
DEPS=pcrecomp
BUILD_ARGS="-DXWIN_ARCH=x86 -DCMAKE_BUILD_TYPE=RelWithDebInfo -DPCRECOMP=../pcrecomp"
EXCLUDE="*.mp4"
EXE=ssc.exe
SHIP=lan                           # built from a retail product: stays on the LAN
RUN='$EXE --run'
QA='py -3 tools\conformance.py --exe "$EXE"'   # milestones from a scripted headless run; SKIP without game/
QA_SKIP='conformance: SKIP'
