# Fallout: Brotherhood of Steel (Xbox), on xboxrecomp.
REPO=https://github.com/sp00nznet/falloutbos-recomp
TOOLSET=cmake
DEPS=xboxrecomp
EXE=fbos.exe
SHIP=lan
RUN_FILES=tools/boot_check.py
# Boots the game headless with a scripted pad and counts milestones (logo,
# menu, character select, first level, no faults). SKIP without game data.
QA='py -3 tools\boot_check.py $EXE'
QA_SKIP='^boot_check: SKIP'
EXCLUDE="deps"
