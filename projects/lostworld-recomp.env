# The Lost World: Jurassic Park (Sega Model 3), on model3recomp. The lifted
# C (src/recomp/) is generated in the checkout from your own romset by
# tools/lift.py and is never committed; the ROM images (roms/) never leave
# the machines that have them.
#
# Not built on the farm yet: the board's window layer links SDL2, which the
# clang-cl builders don't carry. Build in the checkout (MSVC, `cmake --build
# build`) and stage it -- scenarios/lostworld/lan.sh copies build\ into
# build-farm\ itself.
REPO=https://github.com/sp00nznet/lostworld
TOOLSET=cmake
TARGET=lostworld
EXE=lostworld.exe
# LW_ROMS (a machine variable) is the folder holding lw_prog.bin, lw_bank.bin
# and lw_vrom.bin; without it, the checkout's roms\ is used. A role's
# LW_ENV is a file of harness variables (the repo's tools/netlab/*.env:
# scripted coins, starts and trigger pulls); LW_HOST / LW_JOIN start a
# netplay session; LW_FIELDS stops after that many fields and writes shot.ppm.
RUN='$EXE $LW_FIELDS --roms ${LW_ROMS:-roms} ${LW_ENV:+--env $LW_ENV} ${LW_HOST:+--host $LW_HOST} ${LW_JOIN:+--join $LW_JOIN}'
RUN_FILES="tools/netlab/host.env tools/netlab/joiner.env"
PROC=lostworld
WINDOW="The Lost World: Jurassic Park"
SHIP=lan                           # built from a ROM: stays on the LAN
