# A game instance on this machine. Copy to drive/inst/<name>.env (e.g. a.env)
# and adjust. Paths are this machine's (Git Bash style on Windows).
KIND=local

# Where the instance's mailbox, log and frames live.
DIR=/c/netlab/a
PAD=$DIR/pad.txt
LOG=$DIR/game.log
FRAMES=$DIR/frames

# How to launch it. The launcher sees every variable in this file.
START='sh "$NETLAB/games/ps3recomp/run-local.sh"'
STOP='powershell -NoProfile -Command "Get-Process simpsons -EA 0 | Stop-Process -Force"'

# Settings the ps3recomp launcher reads (games/ps3recomp/README.md).
GAME_DIR=~/src/ps3games/simpsons
EXE=build/simpsons.exe
ELF=vfs/PS3_GAME/USRDIR/EBOOT.elf
PSNR=192.0.2.20              # psnr server; empty = offline
PLAYER=player1               # --username
P2P_PORT=3658                # two instances on one machine need two ports
NET_TRACE=                   # 1 = log every packet (slows the game down)
