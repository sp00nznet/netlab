# Your lab, in lab.env (git-ignored). vm/setup-windows.sh makes it from this
# file and fills in the Windows VM's part; or copy it and adjust by hand. The
# vm/, nat/ and builders/ scripts read it, and run from your workstation,
# reaching the Proxmox host over SSH (key login as root).

PVE_HOST=root@192.0.2.10            # the Proxmox host that runs the test VM
VMID=103
VM_NAME=netlab-win
VM_USER=netlab                      # the administrator vm/autounattend.xml creates
VM_CORES=8
VM_MEMORY=16384
VM_DISK_GB=80
VM_STORAGE=local-lvm                # thin storage: the VM only uses what it writes

# ISOs, in ISO_DIR on the Proxmox host.
ISO_DIR=/var/lib/vz/template/iso
ISO_STORAGE=local                   # the Proxmox storage name for ISO_DIR
WIN_ISO=en-us_windows_10_business_editions_version_22h2_x64_dvd.iso
VIRTIO_ISO=virtio-win-0.1.285.iso
ANSWER_ISO=netlab-answer-103.iso    # vm/setup-windows.sh makes it, and deletes it after the install

# The GPU to pass through: its PCI address (all functions) and the
# vendor:device of each function, for vfio-pci.
GPU=0000:43:00
GPU_IDS=1002:73df,1002:ab28

# Networks.
LAN_BRIDGE=vmbr0
NAT_BRIDGE=vmbr99                   # created by nat/nat-up.sh, runtime only
NAT_GW=10.77.0.1
NAT_PREFIX=24
NAT_VM_IP=10.77.0.2
NAT_DNS=1.1.1.1
UDP_DROP_PORTS=3600:3700            # unsolicited UDP the NAT router drops, like a home router

# The Linux test VM (vm/create-linux-vm.sh): Debian 13 + an auto-logged-on Xfce.
LINUX_VMID=150
LINUX_VM_NAME=netlab-linux
LINUX_CORES=4
LINUX_MEMORY=8192
LINUX_DISK_GB=40
LINUX_STORAGE=local-lvm
