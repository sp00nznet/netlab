# A game instance on another Windows machine, reached over SSH. Copy to
# drive/inst/<name>.env (e.g. b.env). The machine is set up with
# vm/prepare-game-box.ps1, which creates TASK and the launcher it runs.
KIND=remote
SSH=Admin@192.0.2.30
JUMP=                        # e.g. root@192.0.2.10 (the Proxmox host) when the box is behind the NAT bridge

# Remote paths, with forward slashes (PowerShell takes them, and they survive
# shell quoting).
DIR=C:/netlab
PAD=$DIR/pad.txt
LOG=$DIR/game.log
FRAMES=$DIR/frames

TASK=netlab-game             # the scheduled task that launches the game in the desktop session
PROC=simpsons                # its process name, for stopping it
